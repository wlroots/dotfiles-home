{
    "layer": "top",
    "position": "top",
    "height": 21,
    "spacing": 0,
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["sway/window"],
    "modules-right": ["tray",  "pulseaudio", "memory", "battery", "sway/language", "clock"],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },
    "sway/window": {
        "format": "{title}",
        "max-length": 50
    },
    "sway/mode": {
        "format": "{}",
        "tooltip": false
    },
    "tray": {
        "icon-size": 13,
        "spacing": 6
    },
    "sway/language": {
        "format": "{short}"
    },
    "pulseaudio": {
        "format": "VOL: {volume}%",
        "format-muted": "VOL: MUTE",
        "interval": 2
    },
    "memory": {
        "format": "MEM: {percentage}%",
        "interval": 2
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "BAT: {capacity}%",
        "format-charging": "CHR: {capacity}%",
        "format-plugged": "PLG: {capacity}%"
    },
    "clock": {
        "format": "{:%Y-%m-%d %H:%M}",
        "interval": 60,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "first-day-of-week": 1
        }
    }
}
