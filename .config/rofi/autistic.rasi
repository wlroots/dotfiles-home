/**
 * ROFI Color theme
 * User: Qball
 * Copyright: Dave Davenport
 */

* {
    selected-foreground:  @foreground;
    foreground:                  rgba ( 187, 187, 187, 100 % );
    alternate-background: rgba ( 18, 18, 18, 100 % );
    red:                         rgba ( 255, 0, 0, 100 % );
    blue:                        rgba ( 0, 85, 119, 100 % );
    active-foreground:           rgba ( 0, 95, 135, 100 % );
    lightbg:                     @background;
    selected-active-foreground:  @foreground;
    alternate-active-background: @alternate-background;
    background:                  rgba ( 34, 34, 34, 100 % );
    bordercolor:                 @selected-active-background;
    lightfg:                     @foreground;
    selected-background:  @blue;
    border-color:                @blue;
    spacing:                     2;
    separatorcolor:              #444444;
    background-color:            @background;
    active-background:           rgba ( 245, 245, 245, 100 % );
    selected-active-background:  rgba ( 0, 95, 135, 100 % );
}
window {
    width: 30%;
    background-color: @blue;
    border:           3;
    padding:          0;
}
mainbox {
    border:  0;
    padding: 0;
}
message {
    border:       0px 0px 0px ;
    border-color: @separatorcolor;
    padding:      0px ;
}
textbox {
    text-color: @foreground;
}
listview {
    fixed-height: 0;
    border:       2px 0px 0px ;
    border-color: @separatorcolor;
    spacing:      0px ;
    scrollbar:    false;
    padding:      0px 0px 0px ;
    lines: 10;
}
element {
    border:  0;
    padding: 0px ;
}
element-text {
    background-color: inherit;
    text-color:       inherit;
}
element.normal.normal {
    background-color: @background;
    text-color:       @foreground;
}
element.normal.urgent {
    background-color: @background;
    text-color:       @foreground;
}
element.normal.active {
    background-color: @active-background;
    text-color:       @active-foreground;
}
element.selected.normal {
    background-color: @selected-background;
    text-color:       @selected-foreground;
}
element.selected.urgent {
    background-color: @selected-active-background;
    text-color:       @selected-foreground;
}
element.selected.active {
    background-color: @selected-active-background;
    text-color:       @selected-active-foreground;
}
element.alternate.normal {
    background-color: @alternate-background;
    text-color:       @foreground;
}
element.alternate.urgent {
    background-color: @alternate-background;
    text-color:       @foreground;
}
element.alternate.active {
    background-color: @alternate-active-background;
    text-color:       @foreground;
}
scrollbar {
    width:        4px ;
    border:       0;
    handle-width: 8px ;
    padding:      0;
}
mode-switcher {
    border:       2px 0px 0px ;
    border-color: @separatorcolor;
}
button.selected {
    background-color: @selected-background;
    text-color:       @selected-foreground;
}
inputbar {
    spacing:    0;
    text-color: @foreground;
    padding:    1px ;
}
case-indicator {
    spacing:    0;
    text-color: @foreground;
}
entry {
    spacing:    0;
    text-color: @foreground;
}
prompt {
    spacing:    0;
    text-color: @foreground;
}
inputbar {
    children:   [ prompt,textbox-prompt-colon,entry,case-indicator ];
}
textbox-prompt-colon {
    expand:     false;
    str:        ":";
    margin:     0px 0.3em 0em 0em ;
    text-color: @foreground;
}
